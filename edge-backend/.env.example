# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO EDGE SERVER (REPO 1)
# ==========================================

# 1. Cấu hình MQTT Broker nội bộ
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=edge_server
MQTT_PASS=edge_secret_2026
MQTT_CLIENT_ID=edge_server_01

# 2. Cấu hình HTTP & Xác thực Camera ESP32-CAM
API_HOST=0.0.0.0
API_PORT=8000
CAM_SHARED_API_KEY=smart-parking-cam-secret-2026
DEBUG=true
LOG_LEVEL=INFO

# 3. Định danh Bãi đỗ & Thiết bị
DEVICE_ID=ESP32_PARKING_01
CAM_DEVICE_ID=ESP32_CAM_01
LOT_ID=lot_live_01
SLOT_IDS=A1,A2,B1,B2

# 4. Thời gian timeout & hết hạn
DEVICE_COMMAND_TTL_S=60
STATE_STALE_AFTER_S=90

# 5. Cấu hình kết nối Firebase Firestore & Cloud Storage (Repo 2)
FIREBASE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# 6. Ngưỡng phát hiện và nhận diện AI (Phase S4/S5)
YOLO_MODEL_PATH=models/plate_yolo_s.pt
YOLO_CONF_THRESHOLD=0.5
OCR_CONF_THRESHOLD=0.6
